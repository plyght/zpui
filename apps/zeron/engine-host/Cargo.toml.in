# zeron-engine: the UI-free engine host bundled with the Zig client (Zeron.app
# Contents/Helpers/zeron-engine, the Linux tarball's zeron-engine). Generated into a
# staging dir by apps/zeron/scripts/build-engine.sh, which substitutes @ZERON_SRC@ (the
# pinned zeron checkout, tools/upstream/map.json) and copies its Cargo.lock so every
# shared dependency builds at the version upstream pins. No gpui / zeron-ui: only the
# crates `zeron headless` / `zeron mcp` run.
[package]
name = "zeron-engine-host"
version = "@VERSION@"
edition = "2024"
license = "MIT"
publish = false

[[bin]]
name = "zeron-engine"
path = "src/main.rs"

# Standalone: not a member of the zeron workspace (path deps still inherit theirs).
[workspace]

[dependencies]
zeron-engine = { path = "@ZERON_SRC@/crates/engine" }
zeron-mcp = { path = "@ZERON_SRC@/crates/mcp" }
# auth_cli.rs (`status`) dials the running engine.
zeron-rpc = { path = "@ZERON_SRC@/crates/rpc" }
serde_json = "1"
tokio = { version = "1", features = ["full"] }
clap = { version = "4", features = ["derive"] }
anyhow = "1"
libc = "0.2"
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }

[target.'cfg(target_os = "macos")'.dependencies]
mimalloc = { version = "0.1", features = ["v2"] }

# zeron's [profile.release].
[profile.release]
lto = "thin"
strip = "symbols"

[profile.dev]
opt-level = 0

[profile.dev.package."*"]
opt-level = 2
